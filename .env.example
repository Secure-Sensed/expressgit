# --- Admin ---
ADMIN_EMAIL=customer@supportupgrade.com
ADMIN_PASSWORD=
ADMIN_NAME=TransitLink Admin
AUTH_SECRET=                 # long random string (openssl rand -hex 32)

# --- Google Maps ---
VITE_GOOGLE_MAPS_API_KEY=    # Maps JavaScript API, restrict to your domain (browser key)
VITE_GOOGLE_MAPS_MAP_ID=     # optional vector Map ID; falls back to DEMO_MAP_ID
GOOGLE_MAPS_SERVER_KEY=      # Geocoding API, server-side key (optional: built-in city list is used without it)

# --- Database (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TransitLink <customer@supportupgrade.com>
APP_URL=https://your-deployment.vercel.app
BRAND_NAME=TransitLink
